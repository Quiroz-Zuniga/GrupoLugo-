---
import Icono from '../Icono.astro';
const { contenido, whatsapp } = Astro.props;
---

<section
  class="corporate-contact dark"
  id="contacto"
  aria-labelledby="titulo-contacto"
>
  <div class="container contact-grid anim-reveal">
    <div>
      <span class="eyebrow">{contenido.etiqueta}</span>
      <h2 id="titulo-contacto">{contenido.titulo}</h2>
      <p>{contenido.descripcion}</p>
    </div>
    <div>
      {whatsapp ? (
        <a
          class="button"
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icono nombre="whatsapp" />
          {contenido.boton}
          <Icono nombre="arrow" />
        </a>
      ) : (
        <p class="contact-pending">{contenido.pendiente}</p>
      )}
    </div>
  </div>
</section>
<style>
  .corporate-contact {
    background: var(--esmeralda-700);
    color: var(--blanco);
    padding-block: var(--s-16);
    border-top: 3px solid var(--olivo-600);
  }
  .corporate-contact .eyebrow {
    color: var(--almendra-200);
  }
  h2 {
    font-family: var(--font-hero);
    font-size: clamp(2.15rem, 3.4vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--blanco);
  }
  .contact-grid {
    display: grid;
    gap: var(--s-8);
    align-items: center;
  }
  .corporate-contact p {
    color: var(--beis-50);
    margin-top: var(--s-4);
    max-width: 52ch;
    line-height: 1.65;
  }
  .button {
    background: var(--esmeralda-900);
    border-color: rgba(255, 255, 255, 0.25);
  }
  .button:hover {
    background: var(--tierra-900);
    border-color: rgba(255, 255, 255, 0.45);
  }
  .contact-pending {
    background: rgba(11, 43, 33, 0.32);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-left: 3px solid var(--almendra-400);
    border-radius: var(--radius);
    padding: var(--s-5) var(--s-6);
    font-size: var(--text-sm);
    color: var(--beis-100);
  }
  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--s-16);
    }
  }
</style>
