---
interface Props {
  contenido: import('astro:content').CollectionEntry<'institucional'>['data']['historia'];
}
const { contenido } = Astro.props;
---

<section class="history" id="nosotros" aria-labelledby="titulo-historia">
  <div class="container history-grid">
    <div class="history-intro">
      <span class="eyebrow">{contenido.etiqueta}</span>
      <h2 id="titulo-historia">{contenido.titulo}</h2>
      <p>{contenido.introduccion}</p>
    </div>
    <div class="history-stages">
      {contenido.etapas.map((etapa) => (
        <article class="anim-reveal">
          <h3>{etapa.titulo}</h3>
          <p>{etapa.texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .history {
    background: var(--blanco);
    padding-block: var(--s-16);
    border-bottom: 1px solid var(--almendra-200);
  }
  .history-grid {
    display: grid;
    gap: var(--s-12);
  }
  .history-intro .eyebrow {
    color: var(--terracota-700);
  }
  .history-intro h2 {
    font-family: var(--font-hero);
    font-size: clamp(2.15rem, 3.6vw, 3.15rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--esmeralda-900);
    max-width: 14ch;
  }
  .history-intro p {
    margin-top: var(--s-6);
    max-width: 44ch;
    color: var(--tierra-700);
    line-height: 1.7;
  }
  .history-stages {
    display: flex;
    flex-direction: column;
  }
  article {
    position: relative;
    padding-block: var(--s-6);
    border-top: 1px solid var(--almendra-200);
    transition: padding-left var(--transition) cubic-bezier(0.22, 1, 0.36, 1);
  }
  article:first-child {
    border-top: 2px solid var(--esmeralda-900);
  }
  article:last-child {
    border-bottom: 1px solid var(--almendra-200);
  }
  article:hover {
    padding-left: var(--s-3);
  }
  h3 {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--esmeralda-900);
  }
  h3::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: var(--pill);
    background: var(--terracota-600);
    flex-shrink: 0;
  }
  article p {
    margin-top: var(--s-3);
    font-size: var(--text-body);
    color: var(--tierra-900);
    max-width: 58ch;
  }
  @media (min-width: 768px) {
    .history {
      padding-block: var(--s-24);
    }
    .history-grid {
      grid-template-columns: 0.95fr 1.25fr;
      gap: var(--s-16);
    }
    .history-intro {
      align-self: start;
      position: sticky;
      top: calc(var(--header-height) + var(--s-8));
    }
  }
</style>
