---
interface Props {
  contenido: import('astro:content').CollectionEntry<'institucional'>['data']['valores'];
}
const { contenido } = Astro.props;
---

<section class="values" id="valores" aria-labelledby="titulo-valores">
  <div class="container">
    <span class="eyebrow">{contenido.etiqueta}</span>
    <h2 id="titulo-valores">{contenido.titulo}</h2>
    <ul>
      {contenido.items.map((valor) => (
        <li class="anim-reveal">
          <span aria-hidden="true">↗</span>
          {valor}
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .values {
    background: var(--blanco);
    padding-block: var(--s-16);
  }
  .values .eyebrow {
    color: var(--terracota-700);
  }
  h2 {
    font-family: var(--font-hero);
    font-size: clamp(2.1rem, 3.4vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--esmeralda-900);
  }
  ul {
    display: grid;
    gap: var(--s-4) var(--s-6);
    list-style: none;
    padding: 0;
    margin: var(--s-12) 0 0;
  }
  li {
    display: flex;
    align-items: start;
    gap: var(--s-3);
    border-top: 1px solid var(--almendra-200);
    padding: var(--s-5) var(--s-3);
    border-radius: 0 0 var(--radius) var(--radius);
    font-weight: 500;
    color: var(--esmeralda-900);
    line-height: 1.45;
    transition:
      background var(--transition) ease,
      border-color var(--transition) ease,
      padding-left var(--transition) cubic-bezier(0.22, 1, 0.36, 1);
  }
  li:hover {
    background: var(--beis-50);
    border-top-color: var(--esmeralda-700);
    padding-left: var(--s-4);
  }
  li span {
    color: var(--terracota-700);
    transition: transform var(--transition) cubic-bezier(0.22, 1, 0.36, 1);
  }
  li:hover span {
    transform: translate(2px, -2px);
  }
  @media (min-width: 480px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .values {
      padding-block: var(--s-24);
    }
    ul {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
