---
interface Props {
  contenido: import('astro:content').CollectionEntry<'institucional'>['data']['valores'];
}
const { contenido } = Astro.props;
---

<section class="values" id="valores" aria-labelledby="titulo-valores">
  <div class="container">
    <span class="eyebrow">{contenido.etiqueta}</span>
    <h2 id="titulo-valores">{contenido.titulo}</h2>
    <ul>
      {contenido.items.map((valor) => (
        <li>
          <span aria-hidden="true">↗</span>
          {valor}
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .values {
    background: var(--blanco);
    padding-block: var(--s-12) var(--s-16);
  }
  ul {
    display: grid;
    gap: 0 var(--s-8);
    list-style: none;
    padding: 0;
    margin: var(--s-8) 0 0;
  }
  li {
    display: flex;
    align-items: start;
    gap: var(--s-3);
    border-top: 1px solid var(--almendra-200);
    padding-block: var(--s-4);
    font-weight: 500;
    line-height: 1.5;
  }
  li span {
    color: var(--terracota-700);
  }
  @media (min-width: 480px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    ul {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
