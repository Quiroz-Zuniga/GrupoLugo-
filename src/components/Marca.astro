---
import { Image } from 'astro:assets';
import logo from '../assets/logo/grupo-lugo-transparente.png';
import { sitio } from '../config/sitio';
---

<a class="marca" href="/#inicio" aria-label={sitio.nombre}>
  <Image
    src={logo}
    width={64}
    height={78}
    alt={sitio.etiquetas.logoAlt}
    loading="eager"
  />
  <span>{sitio.descriptor}</span>
</a>
<style>
  .marca {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    flex-shrink: 0;
  }
  .marca img {
    width: 44px;
    height: 54px;
    object-fit: contain;
  }
  .marca span {
    max-width: 115px;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.45;
    color: var(--esmeralda-900);
  }
  @media (min-width: 1024px) {
    .marca img {
      width: 50px;
      height: 61px;
    }
  }
  @media (max-width: 767px) {
    .marca span {
      display: none;
    }
  }
</style>
