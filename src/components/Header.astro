---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Marca from './Marca.astro';
import Icono from './Icono.astro';
import { sitio } from '../config/sitio';

const { whatsapp } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const residenciales = (await getCollection('proyectos'))
  .filter((p) => p.data.publicado)
  .sort((a, b) => a.data.orden - b.data.orden);

function isItemActive(href: string) {
  const cleanHref = href.replace(/\/$/, '') || '/';
  if (cleanHref === '/') return currentPath === '/';
  if (cleanHref.startsWith('/#')) return false;
  return currentPath === cleanHref || currentPath.startsWith(`${cleanHref}/`);
}

const isProjectsActive =
  currentPath === '/proyectos' || currentPath.startsWith('/proyectos/');
---

<header class="header">
  <div class="container header-inner">
    <Marca />

    <nav class="desktop-nav" aria-label="Principal">
      <a
        href="/"
        class:list={['nav-link', { active: currentPath === '/' }]}
        aria-current={currentPath === '/' ? 'page' : undefined}
      >
        Inicio
      </a>

      <a href="/#nosotros" class="nav-link">
        Nosotros
      </a>

      <div class="nav-dropdown">
        <a
          href="/proyectos"
          class:list={[
            'nav-link',
            'dropdown-trigger',
            { active: isProjectsActive },
          ]}
          aria-current={currentPath === '/proyectos' ? 'page' : undefined}
        >
          <span>{sitio.etiquetas.residenciales}</span>
          <Icono nombre="chevron" clase="dropdown-chevron" />
        </a>

        <div class="dropdown-bridge">
          <div class="dropdown-panel" role="region" aria-label="Residenciales">
            <div class="dropdown-header">
              <span class="dropdown-label">Nuestros proyectos</span>
              <a href="/proyectos" class="dropdown-all">
                <span>{sitio.etiquetas.verTodosProyectos}</span>
                <Icono nombre="arrow" clase="dropdown-arrow" />
              </a>
            </div>
            <div class="dropdown-grid">
              {residenciales.map((res) => {
                const href = `/proyectos/${res.data.slug}`;
                const active = isItemActive(href);
                return (
                  <a
                    href={href}
                    class:list={['dropdown-item', { active }]}
                    aria-current={active ? 'page' : undefined}
                  >
                    <Image
                      src={res.data.hero}
                      alt=""
                      width={96}
                      height={60}
                      class="dropdown-thumb"
                      loading="eager"
                    />
                    <span class="dropdown-info">
                      <span class="dropdown-title">{res.data.nombre}</span>
                      <span class="dropdown-zone">{res.data.zona}</span>
                    </span>
                  </a>
                );
              })}
            </div>
          </div>
        </div>
      </div>

      <a href="/#actividades" class="nav-link">
        Actividades
      </a>
      <a href="/#valores" class="nav-link">
        Valores
      </a>
    </nav>

    <div class="header-actions">
      <a
        class="button header-contact"
        href={whatsapp || '#contacto'}
        {...(whatsapp ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <Icono nombre="whatsapp" />
        <span>Contáctanos</span>
      </a>

      <details class="mobile-menu">
        <summary aria-label={sitio.etiquetas.menu}>
          <span></span>
          <span></span>
          <span></span>
        </summary>
        <nav aria-label="Principal móvil">
          <div class="mobile-section-header">
            <span class="eyebrow">{sitio.etiquetas.residenciales}</span>
            <a href="/proyectos" class="mobile-all-link">
              Ver todas
            </a>
          </div>
          <div class="mobile-projects-list">
            {residenciales.map((res) => {
              const href = `/proyectos/${res.data.slug}`;
              const active = isItemActive(href);
              return (
                <a
                  href={href}
                  class:list={['mobile-project-link', { active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  <span class="mobile-project-name">{res.data.nombre}</span>
                  <span class="mobile-project-zone">{res.data.zona}</span>
                </a>
              );
            })}
          </div>

          <div class="mobile-section-header">
            <span class="eyebrow">Grupo Lugo</span>
          </div>
          <div class="mobile-company-links">
            {sitio.menu.map((item) => (
              <a href={item.href} class="mobile-nav-link">
                {item.texto}
              </a>
            ))}
          </div>

          <a
            class="button mobile-contact-btn"
            href={whatsapp || '#contacto'}
            {...(whatsapp
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
          >
            <Icono nombre="whatsapp" />
            <span>Contáctanos</span>
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--blanco);
    border-bottom: 1px solid var(--almendra-200);
    box-shadow: 0 2px 12px rgba(11, 43, 33, 0.05);
  }
  .header-inner {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .desktop-nav {
    display: none;
    align-items: center;
    gap: var(--s-6);
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    padding-block: var(--s-2);
    color: var(--tierra-900);
    transition: color var(--transition);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--esmeralda-700);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--transition);
  }
  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--esmeralda-700);
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }
  .nav-link.active {
    color: var(--esmeralda-700);
    font-weight: 600;
  }

  /* DROPDOWN DESKTOP */
  .nav-dropdown {
    position: relative;
  }
  .dropdown-chevron {
    width: 15px;
    height: 15px;
    transition: transform var(--transition);
  }
  .nav-dropdown:hover .dropdown-chevron,
  .nav-dropdown:focus-within .dropdown-chevron {
    transform: rotate(180deg);
  }
  .dropdown-bridge {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px) scale(0.985);
    transform-origin: top center;
    padding-top: 14px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 220ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 220ms;
  }
  .nav-dropdown:hover .dropdown-bridge,
  .nav-dropdown:focus-within .dropdown-bridge {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) scale(1);
  }
  .dropdown-panel {
    width: min(640px, 90vw);
    background: var(--blanco);
    border: 1px solid var(--almendra-200);
    border-radius: 12px;
    padding: var(--s-5);
    box-shadow: 0 18px 40px rgba(11, 43, 33, 0.12);
  }
  .dropdown-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-bottom: var(--s-3);
    margin-bottom: var(--s-3);
    border-bottom: 1px solid var(--almendra-200);
  }
  .dropdown-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terracota-700);
  }
  .dropdown-all {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--esmeralda-700);
    text-decoration: none;
  }
  .dropdown-all:hover {
    text-decoration: underline;
  }
  .dropdown-arrow {
    width: 14px;
    height: 14px;
  }
  .dropdown-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-2);
  }
  .dropdown-item {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2);
    border-radius: var(--radius);
    border: 1px solid transparent;
    text-decoration: none;
    transition:
      background var(--transition),
      border-color var(--transition);
  }
  .dropdown-item:hover,
  .dropdown-item:focus-visible {
    background: var(--beis-50);
    border-color: var(--almendra-200);
  }
  .dropdown-item.active {
    background: var(--olivo-50);
    border-color: var(--olivo-600);
  }
  .dropdown-thumb {
    width: 64px;
    height: 40px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
    border: 1px solid var(--almendra-200);
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .dropdown-item:hover .dropdown-thumb {
    transform: scale(1.04);
  }
  .dropdown-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .dropdown-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--esmeralda-900);
    line-height: 1.25;
  }
  .dropdown-item.active .dropdown-title {
    color: var(--esmeralda-700);
  }
  .dropdown-zone {
    font-size: var(--text-xs);
    color: var(--tierra-700);
    line-height: 1.3;
  }

  /* HEADER ACTIONS & MOBILE */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex-shrink: 0;
  }
  .header-contact {
    min-height: 40px;
    padding: var(--s-2) var(--s-4);
    font-size: var(--text-xs);
    gap: var(--s-2);
    flex-shrink: 0;
  }
  .header-contact svg {
    width: 18px;
    height: 18px;
  }
  .mobile-menu summary {
    width: 44px;
    height: 44px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius);
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu summary span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--esmeralda-900);
    border-radius: 2px;
    transition:
      transform var(--transition),
      opacity var(--transition);
  }
  .mobile-menu nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--blanco);
    padding: var(--s-5);
    border-bottom: 1px solid var(--almendra-200);
    box-shadow: 0 12px 28px rgba(11, 43, 33, 0.12);
    display: grid;
    gap: var(--s-4);
    max-height: calc(100dvh - var(--header-height));
    overflow-y: auto;
  }
  .mobile-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--almendra-200);
    padding-bottom: var(--s-2);
  }
  .mobile-section-header .eyebrow {
    color: var(--terracota-700);
    margin-bottom: 0;
  }
  .mobile-section-header .eyebrow::after {
    display: none;
  }
  .mobile-all-link {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--esmeralda-700);
    text-decoration: none;
  }
  .mobile-projects-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-2);
  }
  .mobile-project-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: 44px;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radius);
    background: var(--beis-50);
    border: 1px solid var(--almendra-200);
    text-decoration: none;
  }
  .mobile-project-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--esmeralda-900);
  }
  .mobile-project-zone {
    font-size: var(--text-xs);
    color: var(--tierra-700);
    flex-shrink: 0;
  }
  .mobile-project-link.active {
    background: var(--esmeralda-700);
    border-color: var(--esmeralda-700);
  }
  .mobile-project-link.active .mobile-project-name,
  .mobile-project-link.active .mobile-project-zone {
    color: var(--blanco);
  }
  .mobile-company-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-2);
  }
  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    font-size: var(--text-sm);
    text-decoration: none;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radius);
    background: var(--beis-50);
    color: var(--tierra-900);
    border: 1px solid var(--almendra-200);
    text-align: center;
    font-weight: 500;
  }
  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    background: var(--olivo-50);
    color: var(--esmeralda-900);
  }
  .mobile-contact-btn {
    width: 100%;
    margin-top: var(--s-1);
  }
  .mobile-menu[open] nav {
    animation: gl-fade-up 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .mobile-menu[open] summary span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-menu[open] summary span:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu[open] summary span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (min-width: 640px) {
    .mobile-projects-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: flex;
    }
    .mobile-menu {
      display: none;
    }
    .header-contact {
      min-height: 44px;
      padding: var(--s-3) var(--s-5);
      font-size: var(--text-sm);
    }
  }
</style>
