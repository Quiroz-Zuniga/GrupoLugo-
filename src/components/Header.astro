---
import Marca from './Marca.astro';
import Icono from './Icono.astro';
import { sitio } from '../config/sitio';

const { whatsapp } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isItemActive(href: string) {
  const cleanHref = href.replace(/\/$/, '') || '/';
  if (cleanHref === '/') return currentPath === '/';
  return currentPath === cleanHref || currentPath.startsWith(`${cleanHref}/`);
}
---

<header class="header">
  <div class="container header-inner">
    <Marca />

    <nav class="desktop-nav" aria-label="Principal">
      <div class="nav-projects" role="group" aria-label="Residenciales">
        {sitio.residenciales.map((res) => {
          const active = isItemActive(res.href);
          return (
            <a
              href={res.href}
              class:list={['nav-link', { active }]}
              aria-current={active ? 'page' : undefined}
            >
              {res.texto}
            </a>
          );
        })}
      </div>

      <div class="nav-divider" aria-hidden="true"></div>

      <a
        href="/#nosotros"
        class:list={[
          'nav-link',
          'company-link',
          { active: isItemActive('/#nosotros') },
        ]}
      >
        Nosotros
      </a>
    </nav>

    <a
      class="button header-contact"
      href={whatsapp || '#contacto'}
      {...(whatsapp ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      <Icono nombre="whatsapp" />
      <span>{sitio.etiquetas.contacto}</span>
    </a>

    <details class="mobile-menu">
      <summary aria-label={sitio.etiquetas.menu}>
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav aria-label="Principal móvil">
        <div class="mobile-section-header">
          <span class="eyebrow">{sitio.etiquetas.residenciales}</span>
        </div>
        <div class="mobile-projects-grid">
          {sitio.residenciales.map((res) => {
            const active = isItemActive(res.href);
            return (
              <a
                href={res.href}
                class:list={['mobile-nav-link', { active }]}
                aria-current={active ? 'page' : undefined}
              >
                {res.texto}
              </a>
            );
          })}
        </div>

        <div class="mobile-section-header">
          <span class="eyebrow">Grupo Lugo</span>
        </div>
        <div class="mobile-company-links">
          {sitio.menu.map((item) => (
            <a href={item.href} class="mobile-nav-link">
              {item.texto}
            </a>
          ))}
        </div>

        <a
          class="button mobile-contact-btn"
          href={whatsapp || '#contacto'}
          {...(whatsapp
            ? { target: '_blank', rel: 'noopener noreferrer' }
            : {})}
        >
          <Icono nombre="whatsapp" />
          <span>{sitio.etiquetas.contacto}</span>
        </a>
      </nav>
    </details>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--blanco);
    border-bottom: 1px solid var(--almendra-200);
  }
  .header-inner {
    height: 104px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .desktop-nav {
    display: none;
    align-items: center;
    gap: var(--s-3);
  }
  .nav-projects {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex-wrap: wrap;
    justify-content: center;
  }
  .nav-link {
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    padding: 6px 10px;
    border-radius: var(--pill);
    color: var(--tierra-900);
    transition:
      color var(--transition),
      background var(--transition),
      border-color var(--transition);
    border: 1px solid transparent;
  }
  .nav-link:hover {
    color: var(--esmeralda-900);
    background: var(--beis-100);
    text-decoration: none;
  }
  .nav-link.active {
    color: var(--esmeralda-700);
    font-weight: 600;
    background: var(--olivo-50);
    border-color: var(--olivo-600);
  }
  .company-link {
    font-weight: 600;
  }
  .nav-divider {
    width: 1px;
    height: 24px;
    background: var(--almendra-200);
    flex-shrink: 0;
  }
  .header-contact {
    font-size: var(--text-sm);
    padding: var(--s-3) var(--s-4);
    flex-shrink: 0;
  }
  .mobile-menu summary {
    width: 44px;
    height: 44px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    list-style: none;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu summary span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--esmeralda-900);
  }
  .mobile-menu nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--blanco);
    padding: var(--s-6);
    border-bottom: 1px solid var(--almendra-200);
    box-shadow: 0 10px 24px rgba(11, 43, 33, 0.08);
    display: grid;
    gap: var(--s-4);
    max-height: calc(100vh - 110px);
    overflow-y: auto;
  }
  .mobile-section-header {
    border-bottom: 1px solid var(--almendra-200);
    padding-bottom: var(--s-1);
    margin-top: var(--s-2);
  }
  .mobile-section-header .eyebrow {
    color: var(--terracota-700);
    margin-bottom: 0;
  }
  .mobile-section-header .eyebrow::after {
    display: none;
  }
  .mobile-projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-2);
  }
  .mobile-company-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-2);
  }
  .mobile-nav-link {
    font-size: var(--text-sm);
    text-decoration: none;
    padding: var(--s-3);
    border-radius: var(--radius);
    background: var(--beis-50);
    color: var(--tierra-900);
    border: 1px solid var(--almendra-200);
    text-align: center;
    font-weight: 500;
  }
  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    background: var(--olivo-50);
    color: var(--esmeralda-900);
  }
  .mobile-nav-link.active {
    background: var(--esmeralda-700);
    color: var(--blanco);
    border-color: var(--esmeralda-700);
    font-weight: 600;
  }
  .mobile-contact-btn {
    width: 100%;
    margin-top: var(--s-2);
  }
  .mobile-menu[open] summary span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-menu[open] summary span:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu[open] summary span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: flex;
    }
    .mobile-menu {
      display: none;
    }
    .header-contact {
      padding: var(--s-3) var(--s-6);
    }
  }
</style>
