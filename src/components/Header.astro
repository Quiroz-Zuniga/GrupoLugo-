---
import { getCollection } from 'astro:content';
import Marca from './Marca.astro';
import Icono from './Icono.astro';
import { sitio } from '../config/sitio';

const { whatsapp, overlay = true } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const residenciales = (await getCollection('proyectos'))
  .filter((p) => p.data.publicado)
  .sort((a, b) => a.data.orden - b.data.orden);

function isItemActive(href: string) {
  const cleanHref = href.replace(/\/$/, '') || '/';
  if (cleanHref === '/') return currentPath === '/';
  if (cleanHref.startsWith('/#')) return false;
  return currentPath === cleanHref || currentPath.startsWith(`${cleanHref}/`);
}

function nombreCorto(nombre: string) {
  return nombre.replace(/^Residencial\s+/i, '').replace(/\s+Etapa$/i, '');
}

const isProjectsCatalog = currentPath === '/proyectos';
---

<header class:list={['header', { 'header--overlay dark': overlay }]}>
  <div class="header-inner">
    <Marca overlay={overlay} />

    <nav class="desktop-nav" aria-label="Principal">
      <div class="nav-row nav-row-projects" aria-label="Residenciales">
        {residenciales.map((res) => {
          const href = `/proyectos/${res.data.slug}`;
          const active = isItemActive(href);
          return (
            <a
              href={href}
              title={res.data.nombre}
              class:list={['nav-link nav-link--project', { active }]}
              aria-current={active ? 'page' : undefined}
            >
              {nombreCorto(res.data.nombre)}
            </a>
          );
        })}
      </div>

      <div class="nav-row nav-row-company">
        <a
          href="/"
          class:list={['nav-link nav-link--secondary', { active: currentPath === '/' }]}
          aria-current={currentPath === '/' ? 'page' : undefined}
        >
          Inicio
        </a>
        <a href="/#nosotros" class="nav-link nav-link--secondary">
          Nosotros
        </a>
        <a href="/#actividades" class="nav-link nav-link--secondary">
          Actividades
        </a>
        <a href="/#valores" class="nav-link nav-link--secondary">
          Valores
        </a>
        <a
          href="/proyectos"
          class:list={['nav-link nav-link--secondary', { active: isProjectsCatalog }]}
          aria-current={isProjectsCatalog ? 'page' : undefined}
        >
          {sitio.etiquetas.residenciales}
        </a>
      </div>
    </nav>

    <div class="header-actions">
      <a
        class:list={['button header-contact', { 'header-contact--glass': overlay }]}
        href={whatsapp || '#contacto'}
        {...(whatsapp ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <Icono nombre="whatsapp" />
        <span>Contáctanos</span>
      </a>

      <details class="mobile-menu">
        <summary aria-label={sitio.etiquetas.menu}>
          <span></span>
          <span></span>
          <span></span>
        </summary>
        <nav aria-label="Principal móvil">
          <div class="mobile-section-header">
            <span class="eyebrow">{sitio.etiquetas.residenciales}</span>
            <a href="/proyectos" class="mobile-all-link">
              Ver todas
            </a>
          </div>
          <div class="mobile-projects-list">
            {residenciales.map((res) => {
              const href = `/proyectos/${res.data.slug}`;
              const active = isItemActive(href);
              return (
                <a
                  href={href}
                  class:list={['mobile-project-link', { active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  <span class="mobile-project-name">{res.data.nombre}</span>
                  <span class="mobile-project-zone">{res.data.zona}</span>
                </a>
              );
            })}
          </div>

          <div class="mobile-section-header">
            <span class="eyebrow">{sitio.nombre}</span>
          </div>
          <div class="mobile-company-links">
            {sitio.menu.map((item) => (
              <a href={item.href} class="mobile-nav-link">
                {item.texto}
              </a>
            ))}
          </div>

          <a
            class="button mobile-contact-btn"
            href={whatsapp || '#contacto'}
            {...(whatsapp
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
          >
            <Icono nombre="whatsapp" />
            <span>Contáctanos</span>
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--blanco);
    border-bottom: 1px solid var(--almendra-200);
    box-shadow: 0 2px 12px rgba(11, 43, 33, 0.05);
  }

  .header--overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: linear-gradient(
      180deg,
      rgba(11, 43, 33, 0.68) 0%,
      rgba(11, 43, 33, 0.28) 72%,
      rgba(11, 43, 33, 0) 100%
    );
    border-bottom: 1px solid transparent;
    box-shadow: none;
  }

  @keyframes gl-header-scroll {
    from {
      background: rgba(11, 43, 33, 0);
      border-bottom-color: transparent;
      box-shadow: none;
      backdrop-filter: blur(0px);
    }
    to {
      background: rgba(11, 43, 33, 0.92);
      border-bottom-color: rgba(255, 255, 255, 0.14);
      box-shadow: 0 8px 28px rgba(11, 43, 33, 0.22);
      backdrop-filter: blur(12px);
    }
  }

  @supports (animation-timeline: scroll()) {
    .header--overlay {
      position: fixed;
      animation: gl-header-scroll linear both;
      animation-timeline: scroll(root);
      animation-range: 10px 140px;
    }
  }

  .header-inner {
    width: min(calc(100% - var(--s-5) * 2), 1440px);
    margin-inline: auto;
    min-height: var(--header-height);
    padding-block: var(--s-2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }

  /* DESKTOP TWO-ROW CELAQUE-STYLE NAV */
  .desktop-nav {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 4px;
    flex: 1 1 auto;
    min-width: 0;
  }

  .nav-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    column-gap: clamp(0.55rem, 0.95vw, 1.15rem);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-size: clamp(0.73rem, 0.84vw, 0.84rem);
    font-weight: 400;
    text-decoration: none;
    white-space: nowrap;
    padding-block: 2px;
    color: var(--tierra-900);
    transition:
      color var(--transition) ease,
      opacity var(--transition) ease;
  }

  .nav-link--secondary {
    font-size: clamp(0.72rem, 0.8vw, 0.8rem);
    opacity: 0.9;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--esmeralda-700);
    opacity: 1;
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-link.active {
    font-weight: 500;
  }

  .header--overlay .nav-link {
    color: var(--blanco);
    text-shadow: 0 1px 6px rgba(11, 43, 33, 0.45);
  }

  .header--overlay .nav-link:hover,
  .header--overlay .nav-link:focus-visible,
  .header--overlay .nav-link.active {
    color: var(--blanco);
    opacity: 1;
  }

  /* HEADER ACTIONS & GLASS PILL CTA */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex-shrink: 0;
  }

  .header-contact {
    min-height: 40px;
    padding: var(--s-2) var(--s-4);
    font-size: var(--text-xs);
    gap: var(--s-2);
    flex-shrink: 0;
  }

  .header-contact--glass {
    background: rgba(11, 43, 33, 0.44);
    border: 1px solid rgba(255, 255, 255, 0.38);
    color: var(--blanco);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    letter-spacing: 0.06em;
    font-weight: 500;
  }

  .header-contact--glass:hover,
  .header-contact--glass:focus-visible {
    background: var(--esmeralda-700);
    border-color: rgba(255, 255, 255, 0.6);
    color: var(--blanco);
    box-shadow: 0 8px 22px rgba(11, 43, 33, 0.28);
  }

  .header-contact svg {
    width: 17px;
    height: 17px;
  }

  /* MOBILE MENU */
  .mobile-menu summary {
    width: 44px;
    height: 44px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius);
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu summary span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--esmeralda-900);
    border-radius: 2px;
    transition:
      transform var(--transition),
      opacity var(--transition);
  }
  .header--overlay .mobile-menu summary span {
    background: var(--blanco);
    box-shadow: 0 1px 4px rgba(11, 43, 33, 0.4);
  }
  .mobile-menu nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--blanco);
    color: var(--esmeralda-900);
    padding: var(--s-5);
    border-bottom: 1px solid var(--almendra-200);
    box-shadow: 0 16px 36px rgba(11, 43, 33, 0.18);
    display: grid;
    gap: var(--s-4);
    max-height: calc(100dvh - var(--header-height));
    overflow-y: auto;
  }
  .mobile-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--almendra-200);
    padding-bottom: var(--s-2);
  }
  .mobile-section-header .eyebrow {
    color: var(--terracota-700);
    margin-bottom: 0;
  }
  .mobile-section-header .eyebrow::after {
    display: none;
  }
  .mobile-all-link {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--esmeralda-700);
    text-decoration: none;
  }
  .mobile-projects-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-2);
  }
  .mobile-project-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: 44px;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radius);
    background: var(--beis-50);
    border: 1px solid var(--almendra-200);
    text-decoration: none;
  }
  .mobile-project-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--esmeralda-900);
  }
  .mobile-project-zone {
    font-size: var(--text-xs);
    color: var(--tierra-700);
    flex-shrink: 0;
  }
  .mobile-project-link.active {
    background: var(--esmeralda-700);
    border-color: var(--esmeralda-700);
  }
  .mobile-project-link.active .mobile-project-name,
  .mobile-project-link.active .mobile-project-zone {
    color: var(--blanco);
  }
  .mobile-company-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-2);
  }
  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    font-size: var(--text-sm);
    text-decoration: none;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radius);
    background: var(--beis-50);
    color: var(--tierra-900);
    border: 1px solid var(--almendra-200);
    text-align: center;
    font-weight: 500;
  }
  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    background: var(--olivo-50);
    color: var(--esmeralda-900);
  }
  .mobile-contact-btn {
    width: 100%;
    margin-top: var(--s-1);
  }
  .mobile-menu[open] nav {
    animation: gl-fade-up 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .mobile-menu[open] summary span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-menu[open] summary span:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu[open] summary span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (min-width: 640px) {
    .mobile-projects-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .desktop-nav {
      display: flex;
    }
    .mobile-menu {
      display: none;
    }
    .header-contact {
      min-height: 40px;
      padding: var(--s-2) var(--s-4);
      font-size: 0.8125rem;
    }
  }
</style>
