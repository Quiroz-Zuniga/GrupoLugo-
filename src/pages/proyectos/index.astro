---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icono from '../../components/Icono.astro';
import catalogoHero from '../../assets/proyectos/catalogo-hero.jpg';
import { sitio } from '../../config/sitio';
import { enlaceWhatsappInstitucional } from '../../lib/whatsapp';

const proyectos = (await getCollection('proyectos'))
  .filter((p) => p.data.publicado)
  .sort((a, b) => a.data.orden - b.data.orden);

const etiquetasEstado = {
  disponible: 'Disponible',
  'ultimos-lotes': 'Últimos lotes',
  proximamente: 'Próximamente',
  vendido: 'Vendido',
};

const seo = {
  title: 'Residenciales | Grupo Lugo - Lotificación y Urbanización',
  description:
    'Conoce las 8 residenciales y proyectos de lotificación de Grupo Lugo en Danlí y Santa Cruz de Yojoa.',
};

const whatsapp = enlaceWhatsappInstitucional(sitio.whatsapp);
---

<Layout seo={seo} whatsapp={whatsapp}>
  <section class="proyectos-hero dark">
    <Image
      src={catalogoHero}
      alt="Vista aérea ilustrativa de referencia de desarrollos de lotificación de Grupo Lugo"
      class="hero-bg anim-hero-bg"
      widths={[640, 1024, 1376]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container hero-content">
      <nav class="breadcrumb anim-hero" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Proyectos</span>
      </nav>
      <span class="eyebrow hero-eyebrow anim-hero">
        Desarrollos y Lotificaciones
      </span>
      <h1 class="hero-title anim-hero-delay-1">Nuestras Residenciales</h1>
      <div class="hero-lead-row anim-hero-delay-2">
        <p class="hero-lead">
          Explora las 8 residenciales de Grupo Lugo. Cada proyecto cuenta con su
          propia página informativa con ubicación, características y contacto
          directo.
        </p>
        <span class="hero-ref-note">{sitio.etiquetas.imagenReferencia}</span>
      </div>
    </div>
  </section>

  <section class="section proyectos-grid-section">
    <div class="container">
      <div class="projects-grid">
        {proyectos.map((p) => {
          const item = p.data;
          return (
            <article class="project-card anim-reveal">
              <div class="card-visual">
                <Image
                  src={item.hero}
                  alt={item.heroAlt}
                  class="card-img"
                  widths={[480, 720]}
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                  loading="lazy"
                />
                <span class="card-number">0{item.orden}</span>
                <span class:list={['card-badge', `badge-${item.estado}`]}>
                  {etiquetasEstado[item.estado]}
                </span>
              </div>
              <div class="card-body">
                <span class="eyebrow card-eyebrow">{item.zona}</span>
                <h2>
                  <a href={`/proyectos/${item.slug}`}>{item.nombre}</a>
                </h2>
                <div class="card-location">
                  <Icono nombre="pin" clase="card-pin" />
                  <span>{item.apartado1.ubicacion}</span>
                </div>
                <p class="card-desc">{item.apartado2.descripcion}</p>
                <div class="card-footer">
                  <a
                    class="button button-outline"
                    href={`/proyectos/${item.slug}`}
                  >
                    <span>Ver proyecto</span>
                    <Icono nombre="arrow" />
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<style>
  .proyectos-hero {
    position: relative;
    overflow: hidden;
    background: var(--esmeralda-900);
    color: var(--blanco);
    padding-block: var(--s-12) var(--s-16);
    border-bottom: 3px solid var(--olivo-600);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(11, 43, 33, 0.92) 0%,
      rgba(11, 43, 33, 0.78) 55%,
      rgba(11, 43, 33, 0.4) 100%
    );
  }
  .hero-content {
    position: relative;
    z-index: 2;
  }
  .hero-lead-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .hero-ref-note {
    font-size: var(--text-xs);
    color: var(--beis-100);
    background: rgba(11, 43, 33, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 4px 10px;
    border-radius: var(--pill);
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--text-sm);
    color: var(--almendra-200);
    margin-bottom: var(--s-3);
  }
  .breadcrumb a {
    color: var(--beis-100);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .hero-eyebrow {
    color: var(--almendra-400);
  }
  .hero-title {
    font-family: var(--font-hero);
    font-size: var(--text-hero);
    font-weight: 400;
    line-height: 1.05;
    color: var(--blanco);
    margin-bottom: var(--s-3);
  }
  .hero-lead {
    font-size: var(--text-body);
    color: var(--beis-100);
    max-width: 65ch;
  }

  .proyectos-grid-section {
    background: var(--beis-50);
    padding-block: var(--s-16);
  }
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8);
  }
  .project-card {
    background: var(--blanco);
    border: 1px solid var(--almendra-200);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgba(58, 42, 29, 0.04);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }
  .project-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(11, 43, 33, 0.08);
  }
  .card-visual {
    aspect-ratio: 16 / 9;
    background: var(--olivo-50);
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--almendra-200);
  }
  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition);
  }
  .project-card:hover .card-img {
    transform: scale(1.03);
  }
  .card-number {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--terracota-700);
    background: var(--blanco);
    padding: 2px 8px;
    border-radius: var(--pill);
    border: 1px solid var(--almendra-200);
  }
  .card-badge {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.03em;
    background: var(--esmeralda-700);
    color: var(--blanco);
    padding: 3px 10px;
    border-radius: var(--pill);
  }
  .badge-disponible {
    background: var(--olivo-600);
    color: var(--blanco);
  }
  .badge-ultimos-lotes {
    background: var(--terracota-700);
    color: var(--blanco);
  }
  .badge-proximamente {
    background: var(--almendra-200);
    color: var(--tierra-900);
  }
  .badge-vendido {
    background: var(--almendra-400);
    color: var(--tierra-900);
  }
  .card-body {
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    flex-grow: 1;
  }
  .card-eyebrow {
    color: var(--terracota-700);
    margin-bottom: 0;
  }
  .card-eyebrow::after {
    margin-bottom: var(--s-2);
  }
  .card-body h2 {
    font-size: 1.375rem;
    color: var(--esmeralda-900);
  }
  .card-body h2 a {
    color: inherit;
    text-decoration: none;
  }
  .card-body h2 a:hover {
    text-decoration: underline;
  }
  .card-location {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--text-xs);
    color: var(--tierra-700);
  }
  .card-pin {
    color: var(--terracota-600);
    width: 16px;
    height: 16px;
  }
  .card-desc {
    font-size: var(--text-sm);
    color: var(--tierra-900);
    margin-top: var(--s-2);
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-footer {
    margin-top: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--almendra-200);
  }
  .button-outline {
    background: transparent;
    color: var(--esmeralda-700);
    border: 1px solid var(--esmeralda-700);
    width: 100%;
    font-weight: 600;
  }
  .button-outline:hover {
    background: var(--esmeralda-700);
    color: var(--blanco);
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-6);
    }
  }
</style>
