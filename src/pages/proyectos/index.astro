---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icono from '../../components/Icono.astro';
import { sitio } from '../../config/sitio';
import { enlaceWhatsappInstitucional } from '../../lib/whatsapp';

const proyectos = await getCollection('proyectos');
proyectos.sort((a, b) => a.data.orden - b.data.orden);

const seo = {
  title: 'Residenciales | Grupo Lugo - Lotificación y Urbanización',
  description:
    'Conoce las 8 residenciales y proyectos de lotificación de Grupo Lugo. Maquetas informativas con apartados 1 al 5.',
};

const whatsapp = enlaceWhatsappInstitucional(sitio.whatsapp);
---

<Layout seo={seo} whatsapp={whatsapp}>
  <section class="proyectos-hero dark">
    <div class="container">
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Proyectos</span>
      </nav>
      <span class="eyebrow hero-eyebrow">Desarrollos y Lotificaciones</span>
      <h1 class="hero-title">Nuestras Residenciales</h1>
      <p class="hero-lead">
        Explora las 8 residenciales de Grupo Lugo. Cada proyecto cuenta con su
        propia maqueta estructurada de los apartados 1 al 5 con la información
        correspondiente.
      </p>
    </div>
  </section>

  <section class="section proyectos-grid-section">
    <div class="container">
      <div class="projects-grid">
        {proyectos.map((p) => {
          const item = p.data;
          return (
            <article class="project-card">
              <div class="card-visual" aria-hidden="true">
                <span class="card-number">0{item.orden}</span>
                <Icono nombre="leaf" clase="card-visual-icon" />
                <span class="card-badge">{item.estado}</span>
              </div>
              <div class="card-body">
                <span class="eyebrow card-eyebrow">
                  {item.apartado1.etiqueta}
                </span>
                <h2>
                  <a href={`/proyectos/${item.slug}`}>{item.nombre}</a>
                </h2>
                <div class="card-location">
                  <Icono nombre="pin" clase="card-pin" />
                  <span>{item.apartado1.ubicacion}</span>
                </div>
                <p class="card-desc">{item.apartado2.descripcion}</p>
                <div class="card-footer">
                  <a
                    class="button button-outline"
                    href={`/proyectos/${item.slug}`}
                  >
                    <span>Ver maqueta</span>
                    <Icono nombre="arrow" />
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<style>
  .proyectos-hero {
    background: linear-gradient(135deg, var(--esmeralda-900) 0%, #061c15 100%);
    color: var(--blanco);
    padding-block: var(--s-12) var(--s-16);
    border-bottom: 3px solid var(--olivo-600);
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--text-sm);
    color: var(--almendra-200);
    margin-bottom: var(--s-3);
  }
  .breadcrumb a {
    color: var(--beis-100);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .hero-eyebrow {
    color: var(--almendra-400);
  }
  .hero-title {
    font-family: var(--font-hero);
    font-size: var(--text-hero);
    font-weight: 400;
    line-height: 1.05;
    color: var(--blanco);
    margin-bottom: var(--s-3);
  }
  .hero-lead {
    font-size: var(--text-body);
    color: var(--beis-100);
    max-width: 65ch;
  }

  .proyectos-grid-section {
    background: var(--beis-50);
    padding-block: var(--s-16);
  }
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8);
  }
  .project-card {
    background: var(--blanco);
    border: 1px solid var(--almendra-200);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgba(58, 42, 29, 0.04);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }
  .project-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(11, 43, 33, 0.08);
  }
  .card-visual {
    aspect-ratio: 16 / 9;
    background: linear-gradient(
      135deg,
      var(--olivo-50) 0%,
      var(--beis-100) 100%
    );
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    border-bottom: 1px solid var(--almendra-200);
  }
  .card-number {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--terracota-700);
    background: var(--blanco);
    padding: 2px 8px;
    border-radius: var(--pill);
    border: 1px solid var(--almendra-200);
  }
  .card-badge {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--esmeralda-700);
    color: var(--blanco);
    padding: 2px 10px;
    border-radius: var(--pill);
  }
  .card-visual-icon {
    width: 48px;
    height: 48px;
    color: var(--olivo-600);
    opacity: 0.8;
  }
  .card-body {
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    flex-grow: 1;
  }
  .card-eyebrow {
    color: var(--terracota-700);
    margin-bottom: 0;
  }
  .card-eyebrow::after {
    margin-bottom: var(--s-2);
  }
  .card-body h2 {
    font-size: 1.375rem;
    color: var(--esmeralda-900);
  }
  .card-body h2 a {
    color: inherit;
    text-decoration: none;
  }
  .card-body h2 a:hover {
    text-decoration: underline;
  }
  .card-location {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--text-xs);
    color: var(--tierra-700);
  }
  .card-pin {
    color: var(--terracota-600);
    width: 16px;
    height: 16px;
  }
  .card-desc {
    font-size: var(--text-sm);
    color: var(--tierra-900);
    margin-top: var(--s-2);
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-footer {
    margin-top: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--almendra-200);
  }
  .button-outline {
    background: transparent;
    color: var(--esmeralda-700);
    border: 1px solid var(--esmeralda-700);
    width: 100%;
    font-weight: 600;
  }
  .button-outline:hover {
    background: var(--esmeralda-700);
    color: var(--blanco);
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-6);
    }
  }
</style>
