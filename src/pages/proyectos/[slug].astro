---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icono from '../../components/Icono.astro';
import { sitio } from '../../config/sitio';
import { enlaceWhatsapp } from '../../lib/whatsapp';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((item) => ({
    params: { slug: item.data.slug },
    props: { proyecto: item.data },
  }));
}

const { proyecto } = Astro.props;
const whatsapp = enlaceWhatsapp(sitio.whatsapp, proyecto.nombre);
---

<Layout seo={proyecto.seo} whatsapp={whatsapp}>
  <!-- APARTADO 1: Portada (Hero) -->
  <section class="hero-section dark" id="apartado-1">
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/proyectos">Proyectos</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{proyecto.nombre}</span>
      </nav>

      <span class="eyebrow hero-eyebrow">{proyecto.apartado1.etiqueta}</span>
      <h1 class="hero-title">{proyecto.apartado1.titulo}</h1>
      <p class="hero-subtitulo">{proyecto.apartado1.subtitulo}</p>

      <div class="hero-meta">
        <div class="meta-item">
          <Icono nombre="pin" clase="meta-icon" />
          <span>{proyecto.apartado1.ubicacion}</span>
        </div>
        <div class="meta-badge">{proyecto.apartado1.estadoTexto}</div>
      </div>

      <div class="hero-actions">
        <a class="button" href={whatsapp || '#apartado-5'}>
          <Icono nombre="whatsapp" />
          <span>{proyecto.apartado1.botonCta}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- APARTADO 2: Sobre el proyecto -->
  <section class="section about-section" id="apartado-2">
    <div class="container about-grid">
      <div class="about-content">
        <span class="eyebrow">{proyecto.apartado2.etiqueta}</span>
        <h2>{proyecto.apartado2.titulo}</h2>
        <p class="about-description">{proyecto.apartado2.descripcion}</p>
      </div>
      {proyecto.apartado2.frase && (
        <aside class="about-quote">
          <blockquote class="hand">{proyecto.apartado2.frase}</blockquote>
          <div class="quote-line" aria-hidden="true"></div>
        </aside>
      )}
    </div>
  </section>

  <!-- APARTADO 3: Características -->
  <section class="section features-section" id="apartado-3">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">{proyecto.apartado3.etiqueta}</span>
        <h2>{proyecto.apartado3.titulo}</h2>
      </header>

      <div class="features-grid">
        {proyecto.apartado3.items.map((item) => (
          <article class="feature-card">
            <div class="feature-icon-wrapper">
              <Icono nombre={item.icono} clase="feature-icon" />
            </div>
            <h3>{item.titulo}</h3>
            <p>{item.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- APARTADO 4: Galería de la maqueta -->
  <section class="section gallery-section" id="apartado-4">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">{proyecto.apartado4.etiqueta}</span>
        <h2>{proyecto.apartado4.titulo}</h2>
        <p class="section-lead">{proyecto.apartado4.descripcion}</p>
      </header>

      <div class="gallery-grid">
        {proyecto.apartado4.items.map((item) => (
          <article class="gallery-card">
            <div class="gallery-placeholder" aria-hidden="true">
              <span class="placeholder-number">{item.numero}</span>
              <Icono nombre="leaf" clase="placeholder-icon" />
              <span class="placeholder-tag">Maqueta visual</span>
            </div>
            <div class="gallery-info">
              <h3>{item.titulo}</h3>
              <p>{item.texto}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- APARTADO 5: Contacto y WhatsApp (CTA) -->
  <section class="cta-section dark" id="apartado-5">
    <div class="container cta-inner">
      <div class="cta-content">
        <span class="eyebrow cta-eyebrow">{proyecto.apartado5.etiqueta}</span>
        <p class="cta-question">{proyecto.apartado5.pregunta}</p>
        <h2>{proyecto.apartado5.titulo}</h2>
        <p class="cta-text">{proyecto.apartado5.texto}</p>
      </div>

      <div class="cta-action">
        <a
          class="button cta-button"
          href={whatsapp || '#contacto'}
          {...(whatsapp
            ? { target: '_blank', rel: 'noopener noreferrer' }
            : {})}
        >
          <Icono nombre="whatsapp" />
          <span>{proyecto.apartado5.boton}</span>
        </a>
        <p class="hand cta-note">¡Será un gusto atenderte!</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* APARTADO 1: HERO */
  .hero-section {
    background: linear-gradient(135deg, var(--esmeralda-900) 0%, #061c15 100%);
    color: var(--blanco);
    padding-block: var(--s-12) var(--s-16);
    position: relative;
    border-bottom: 3px solid var(--olivo-600);
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--text-sm);
    color: var(--almendra-200);
    margin-bottom: var(--s-2);
  }
  .breadcrumb a {
    color: var(--beis-100);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .hero-eyebrow {
    color: var(--almendra-400);
  }
  .hero-title {
    font-family: var(--font-hero);
    font-size: var(--text-hero);
    font-weight: 400;
    line-height: 1.05;
    color: var(--blanco);
    letter-spacing: -0.01em;
  }
  .hero-subtitulo {
    font-size: var(--text-body);
    color: var(--beis-100);
    max-width: 65ch;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    margin-top: var(--s-2);
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--text-sm);
    color: var(--beis-100);
  }
  .meta-icon {
    color: var(--almendra-400);
  }
  .meta-badge {
    display: inline-flex;
    align-items: center;
    padding: var(--s-1) var(--s-3);
    background: color-mix(in srgb, var(--olivo-600) 40%, transparent);
    border: 1px solid var(--olivo-600);
    border-radius: var(--pill);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--beis-100);
    letter-spacing: 0.05em;
  }
  .hero-actions {
    margin-top: var(--s-6);
  }

  /* SECCIONES BASE */
  .section {
    padding-block: var(--s-16);
  }
  .section-header {
    margin-bottom: var(--s-8);
  }
  .section-lead {
    font-size: var(--text-body);
    color: var(--tierra-700);
    margin-top: var(--s-2);
    max-width: 65ch;
  }

  /* APARTADO 2: SOBRE EL PROYECTO */
  .about-section {
    background: var(--beis-50);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8);
    align-items: center;
  }
  .about-content h2 {
    color: var(--esmeralda-900);
    margin-bottom: var(--s-4);
  }
  .about-description {
    font-size: var(--text-body);
    color: var(--tierra-900);
    max-width: 65ch;
  }
  .about-quote {
    background: var(--blanco);
    padding: var(--s-6) var(--s-8);
    border-radius: var(--radius);
    border-left: 4px solid var(--terracota-600);
    box-shadow: 0 4px 16px rgba(58, 42, 29, 0.04);
  }
  .about-quote blockquote {
    color: var(--esmeralda-900);
    font-size: var(--text-hand);
  }
  .quote-line {
    width: var(--s-8);
    height: 2px;
    background: var(--terracota-600);
    margin-top: var(--s-3);
  }

  /* APARTADO 3: CARACTERÍSTICAS */
  .features-section {
    background: var(--olivo-50);
    border-top: 1px solid var(--almendra-200);
    border-bottom: 1px solid var(--almendra-200);
  }
  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }
  .feature-card {
    background: var(--blanco);
    padding: var(--s-6);
    border-radius: var(--radius);
    border: 1px solid var(--almendra-200);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .feature-icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: var(--pill);
    background: var(--olivo-50);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--esmeralda-700);
  }
  .feature-card h3 {
    color: var(--esmeralda-900);
    font-size: 1.0625rem;
  }
  .feature-card p {
    color: var(--tierra-700);
    font-size: var(--text-sm);
  }

  /* APARTADO 4: GALERÍA */
  .gallery-section {
    background: var(--blanco);
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }
  .gallery-card {
    background: var(--beis-50);
    border: 1px solid var(--almendra-200);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .gallery-placeholder {
    aspect-ratio: 16 / 9;
    background: linear-gradient(
      135deg,
      var(--beis-100) 0%,
      var(--olivo-50) 100%
    );
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    position: relative;
    border-bottom: 1px solid var(--almendra-200);
  }
  .placeholder-number {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--terracota-700);
    background: var(--blanco);
    padding: 2px 8px;
    border-radius: var(--pill);
    border: 1px solid var(--almendra-200);
  }
  .placeholder-icon {
    width: 40px;
    height: 40px;
    color: var(--olivo-600);
    opacity: 0.8;
  }
  .placeholder-tag {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tierra-700);
  }
  .gallery-info {
    padding: var(--s-4) var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }
  .gallery-info h3 {
    font-size: 0.9375rem;
    color: var(--esmeralda-900);
  }
  .gallery-info p {
    font-size: var(--text-xs);
    color: var(--tierra-700);
  }

  /* APARTADO 5: CTA */
  .cta-section {
    background: var(--esmeralda-900);
    color: var(--blanco);
    padding-block: var(--s-16);
    border-top: 1px solid color-mix(in srgb, var(--blanco) 20%, transparent);
  }
  .cta-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8);
    align-items: center;
  }
  .cta-eyebrow {
    color: var(--almendra-400);
  }
  .cta-question {
    font-size: var(--text-sm);
    color: var(--almendra-200);
    margin-bottom: var(--s-2);
  }
  .cta-content h2 {
    color: var(--blanco);
    margin-bottom: var(--s-3);
  }
  .cta-text {
    font-size: var(--text-body);
    color: var(--beis-100);
    max-width: 55ch;
  }
  .cta-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-3);
  }
  .cta-note {
    color: var(--beis-100);
    font-size: var(--text-hand);
  }

  /* RESPONSIVE DESIGN */
  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: 1.6fr 1fr;
      gap: var(--s-12);
    }
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .cta-inner {
      grid-template-columns: 1.8fr 1fr;
      gap: var(--s-12);
    }
    .cta-action {
      align-items: flex-end;
      text-align: right;
    }
  }
</style>
