---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icono from '../../components/Icono.astro';
import GaleriaLightbox from '../../components/GaleriaLightbox.jsx';
import { sitio } from '../../config/sitio';
import { enlaceWhatsapp } from '../../lib/whatsapp';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((item) => ({
    params: { slug: item.data.slug },
    props: { proyecto: item.data },
  }));
}

const { proyecto } = Astro.props;
const whatsapp = enlaceWhatsapp(sitio.whatsapp, proyecto.nombre);

const etiquetasEstado = {
  disponible: 'Disponible',
  'ultimos-lotes': 'Últimos lotes',
  proximamente: 'Próximamente',
  vendido: 'Vendido',
};

const mostrarSubtituloHero =
  proyecto.apartado1.subtitulo.trim().toLowerCase() !==
  proyecto.apartado2.titulo.trim().toLowerCase();

const galeriaItems = await Promise.all(
  proyecto.apartado4.items.map(async (item) => {
    const thumb = await getImage({
      src: item.imagen,
      width: 640,
      height: 480,
      format: 'webp',
    });
    const full = await getImage({
      src: item.imagen,
      width: 1200,
      height: 900,
      format: 'webp',
    });
    return {
      numero: item.numero,
      titulo: item.titulo,
      texto: item.texto,
      alt: item.alt,
      thumbSrc: thumb.src,
      fullSrc: full.src,
      width: 640,
      height: 480,
    };
  }),
);
---

<Layout seo={proyecto.seo} proyecto={proyecto} whatsapp={whatsapp}>
  <!-- APARTADO 1: Portada (Hero) -->
  <section class="hero-section dark" id="apartado-1">
    <Image
      src={proyecto.hero}
      alt={proyecto.heroAlt}
      class="hero-bg anim-hero-bg"
      widths={[640, 1024, 1376]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container hero-inner">
      <nav class="breadcrumb anim-hero" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/proyectos">Proyectos</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{proyecto.nombre}</span>
      </nav>

      <span class="eyebrow hero-eyebrow anim-hero">{proyecto.zona}</span>
      <h1 class="hero-title anim-hero-delay-1">{proyecto.apartado1.titulo}</h1>
      {mostrarSubtituloHero ? (
        <p class="hero-subtitulo anim-hero-delay-1">
          {proyecto.apartado1.subtitulo}
        </p>
      ) : (
        <div class="hero-divider anim-hero-delay-1" aria-hidden="true" />
      )}

      <div class="hero-meta anim-hero-delay-2">
        <div class="meta-item">
          <Icono nombre="pin" clase="meta-icon" />
          <span>{proyecto.apartado1.ubicacion}</span>
        </div>
        <div class="meta-badge">{etiquetasEstado[proyecto.estado]}</div>
      </div>

      <div class="hero-actions anim-hero-delay-3">
        <a class="button" href={whatsapp || '#apartado-5'}>
          <Icono nombre="whatsapp" />
          <span>{proyecto.apartado1.botonCta}</span>
        </a>
        <span class="hero-ref-note">{sitio.etiquetas.imagenReferencia}</span>
      </div>
    </div>
  </section>

  <!-- APARTADO 2: Sobre el proyecto -->
  <section class="section about-section" id="apartado-2">
    <div class="container about-grid anim-reveal">
      <div class="about-content">
        <span class="eyebrow">{proyecto.apartado2.etiqueta}</span>
        <h2>{proyecto.apartado2.titulo}</h2>
        <p class="about-description">{proyecto.apartado2.descripcion}</p>
      </div>
      {proyecto.apartado2.frase && (
        <aside class="about-quote">
          <blockquote class="hand">{proyecto.apartado2.frase}</blockquote>
          <div class="quote-line" aria-hidden="true"></div>
        </aside>
      )}
    </div>
  </section>

  <!-- APARTADO 3: Características -->
  <section class="section features-section" id="apartado-3">
    <div class="container">
      <header class="section-header anim-reveal">
        <span class="eyebrow">{proyecto.apartado3.etiqueta}</span>
        <h2>{proyecto.apartado3.titulo}</h2>
      </header>

      <div class="features-grid">
        {proyecto.apartado3.items.map((item) => (
          <article class="feature-card anim-reveal">
            <div class="feature-icon-wrapper">
              <Icono nombre={item.icono} clase="feature-icon" />
            </div>
            <h3>{item.titulo}</h3>
            <p>{item.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- APARTADO 4: Galería de la maqueta -->
  <section class="section gallery-section" id="apartado-4">
    <div class="container">
      <header class="section-header gallery-header anim-reveal">
        <div>
          <span class="eyebrow">{proyecto.apartado4.etiqueta}</span>
          <h2>{proyecto.apartado4.titulo}</h2>
          <p class="section-lead">{proyecto.apartado4.descripcion}</p>
        </div>
        <span class="gallery-ref-pill">{sitio.etiquetas.maquetaNota}</span>
      </header>

      <GaleriaLightbox
        client:visible
        items={galeriaItems}
        proyectoNombre={proyecto.nombre}
      />
    </div>
  </section>

  <!-- APARTADO 5: Contacto y WhatsApp (CTA) -->
  <section class="cta-section dark" id="apartado-5">
    <div class="container cta-inner anim-reveal">
      <div class="cta-content">
        <span class="eyebrow cta-eyebrow">{proyecto.apartado5.etiqueta}</span>
        <p class="cta-question">{proyecto.apartado5.pregunta}</p>
        <h2>{proyecto.apartado5.titulo}</h2>
        <p class="cta-text">{proyecto.apartado5.texto}</p>
      </div>

      <div class="cta-action">
        <a
          class="button cta-button"
          href={whatsapp || '#contacto'}
          {...(whatsapp
            ? { target: '_blank', rel: 'noopener noreferrer' }
            : {})}
        >
          <Icono nombre="whatsapp" />
          <span>{proyecto.apartado5.boton}</span>
        </a>
        <p class="hand cta-note">¡Será un gusto atenderte!</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* APARTADO 1: HERO */
  .hero-section {
    background: var(--esmeralda-900);
    color: var(--blanco);
    padding-top: calc(var(--header-height) + var(--s-12));
    padding-bottom: var(--s-16);
    min-height: 520px;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    border-bottom: 3px solid var(--olivo-600);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(11, 43, 33, 0.92) 0%,
      rgba(11, 43, 33, 0.78) 50%,
      rgba(11, 43, 33, 0.35) 100%
    );
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .hero-actions {
    margin-top: var(--s-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .hero-ref-note {
    font-size: var(--text-xs);
    color: var(--beis-100);
    background: rgba(11, 43, 33, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 4px 10px;
    border-radius: var(--pill);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--text-sm);
    color: var(--almendra-200);
    margin-bottom: var(--s-2);
  }
  .breadcrumb a {
    color: var(--beis-100);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .hero-eyebrow {
    color: var(--almendra-400);
  }
  .hero-title {
    font-family: var(--font-hero);
    font-size: var(--text-hero);
    font-weight: 400;
    line-height: 1.05;
    color: var(--blanco);
    letter-spacing: -0.01em;
  }
  .hero-subtitulo {
    font-size: var(--text-body);
    color: var(--beis-100);
    max-width: 65ch;
  }
  .hero-divider {
    width: var(--s-12);
    height: 2px;
    background: var(--almendra-400);
    margin-block: var(--s-1);
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    margin-top: var(--s-2);
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--text-sm);
    color: var(--beis-100);
  }
  .meta-icon {
    color: var(--almendra-400);
  }
  .meta-badge {
    display: inline-flex;
    align-items: center;
    padding: var(--s-1) var(--s-3);
    background: color-mix(in srgb, var(--olivo-600) 40%, transparent);
    border: 1px solid var(--olivo-600);
    border-radius: var(--pill);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--beis-100);
    letter-spacing: 0.05em;
  }

  /* SECCIONES BASE */
  .section {
    padding-block: var(--s-16);
  }
  .section-header {
    margin-bottom: var(--s-12);
  }
  .section-header .eyebrow,
  .about-content .eyebrow {
    color: var(--terracota-700);
  }
  .section h2,
  .cta-content h2 {
    font-family: var(--font-hero);
    font-size: clamp(2.05rem, 3.3vw, 2.9rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .section-lead {
    font-size: var(--text-body);
    color: var(--tierra-700);
    margin-top: var(--s-3);
    max-width: 62ch;
  }

  /* APARTADO 2: SOBRE EL PROYECTO */
  .about-section {
    background: var(--beis-50);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8);
    align-items: center;
  }
  .about-content h2 {
    color: var(--esmeralda-900);
    margin-bottom: var(--s-4);
  }
  .about-description {
    font-size: var(--text-body);
    color: var(--tierra-900);
    max-width: 65ch;
  }
  .about-quote {
    background: var(--blanco);
    padding: var(--s-6) var(--s-8);
    border-radius: var(--radius);
    border-left: 4px solid var(--terracota-600);
    box-shadow: 0 4px 16px rgba(58, 42, 29, 0.04);
  }
  .about-quote blockquote {
    color: var(--esmeralda-900);
    font-size: var(--text-hand);
  }
  .quote-line {
    width: var(--s-8);
    height: 2px;
    background: var(--terracota-600);
    margin-top: var(--s-3);
  }

  /* APARTADO 3: CARACTERÍSTICAS */
  .features-section {
    background: var(--olivo-50);
    border-top: 1px solid var(--almendra-200);
    border-bottom: 1px solid var(--almendra-200);
  }
  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }
  .feature-card {
    background: var(--blanco);
    padding: var(--s-6);
    border-radius: var(--radius);
    border: 1px solid var(--almendra-200);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    transition:
      transform var(--transition) cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow var(--transition) cubic-bezier(0.22, 1, 0.36, 1),
      border-color var(--transition);
  }
  .feature-card:hover {
    transform: translateY(-3px);
    border-color: var(--olivo-600);
    box-shadow: 0 10px 24px rgba(11, 43, 33, 0.06);
  }
  .feature-icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: var(--pill);
    background: var(--olivo-50);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--esmeralda-700);
    transition:
      background var(--transition),
      transform var(--transition) cubic-bezier(0.22, 1, 0.36, 1);
  }
  .feature-card:hover .feature-icon-wrapper {
    background: var(--beis-100);
    transform: scale(1.06);
  }
  .feature-card h3 {
    color: var(--esmeralda-900);
    font-size: 1.0625rem;
  }
  .feature-card p {
    color: var(--tierra-700);
    font-size: var(--text-sm);
  }

  /* APARTADO 4: GALERÍA */
  .gallery-section {
    background: var(--blanco);
  }
  .gallery-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .gallery-ref-pill {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--tierra-700);
    background: var(--beis-50);
    border: 1px solid var(--almendra-200);
    padding: 4px 12px;
    border-radius: var(--pill);
  }

  /* APARTADO 5: CTA */
  .cta-section {
    background: var(--esmeralda-900);
    color: var(--blanco);
    padding-block: var(--s-16);
    border-top: 1px solid color-mix(in srgb, var(--blanco) 20%, transparent);
  }
  .cta-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8);
    align-items: center;
  }
  .cta-eyebrow {
    color: var(--almendra-400);
  }
  .cta-question {
    font-size: var(--text-sm);
    color: var(--almendra-200);
    margin-bottom: var(--s-2);
  }
  .cta-content h2 {
    color: var(--blanco);
    margin-bottom: var(--s-3);
  }
  .cta-text {
    font-size: var(--text-body);
    color: var(--beis-100);
    max-width: 55ch;
  }
  .cta-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-3);
  }
  .cta-note {
    color: var(--beis-100);
    font-size: var(--text-hand);
  }

  /* RESPONSIVE DESIGN */
  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .section {
      padding-block: var(--s-24);
    }
    .about-grid {
      grid-template-columns: 1.55fr 1fr;
      gap: var(--s-16);
    }
    .features-grid {
      grid-template-columns: repeat(6, 1fr);
    }
    .feature-card {
      grid-column: span 2;
    }
    .feature-card:nth-child(4):nth-last-child(2),
    .feature-card:nth-child(5):last-child {
      grid-column: span 3;
    }
    .cta-inner {
      grid-template-columns: 1.8fr 1fr;
      gap: var(--s-12);
    }
    .cta-action {
      align-items: flex-end;
      text-align: right;
    }
  }
</style>
